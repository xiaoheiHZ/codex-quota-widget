<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CodexQuotaWidget</AssemblyName>
    <RootNamespace>CodexQuotaWidget</RootNamespace>
    <Version>1.1.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\widget.ico</ApplicationIcon>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- WPF owns the DPI manifest; WinForms is used only for the tray icon. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\widget.ico" />
    <Resource Include="Assets\Fonts\SourceHanSansCN-Medium.otf" />
    <Resource Include="Assets\Fonts\LICENSE.txt" />
    <None Update="Assets\Fonts\LICENSE.txt" CopyToPublishDirectory="PreserveNewest" TargetPath="SourceHanSans-LICENSE.txt" />
  </ItemGroup>
</Project>
